<p><%= accessible_t("mailers.hello", email: @email) %></p>

<% if @recording_label.present? %>
  <p><%= accessible_t("mailers.invitation.body_html", inviter: @manager_actor_display_name, role: @role_label, recording: @recording_label) %></p>
<% else %>
  <p><%= accessible_t("mailers.invitation.body_html_without_recording", inviter: @manager_actor_display_name, role: @role_label) %></p>
<% end %>

<% if @acceptance_url.present? %>
  <p><a href="<%= @acceptance_url %>"><%= accessible_t("mailers.invitation.accept") %></a></p>
<% end %>
