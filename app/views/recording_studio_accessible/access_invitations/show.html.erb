<% content_for :title, @recording_label.presence || accessible_t("invitations.title") %>
<% content_for :subtitle, @invitation.email %>

<div class="mt-6 w-full max-w-xl">
  <%= render FlatPack::List::Component.new(divider: true) do %>
    <%= render FlatPack::List::Item.new do %>
      <%= accessible_t("invitations.email", email: @invitation.email) %>
    <% end %>
    <%= render FlatPack::List::Item.new do %>
      <%= accessible_t("invitations.role", role: accessible_role_name(@invitation.role)) %>
    <% end %>
    <%= render FlatPack::List::Item.new do %>
      <%= accessible_t("invitations.recording", recording: @recording_label) %>
    <% end %>
    <%= render FlatPack::List::Item.new do %>
      <%= accessible_t("invitations.state", state: accessible_invitation_state(@invitation_state)) %>
    <% end %>
  <% end %>

  <% if @current_actor.blank? %>
    <p class="text-base leading-7 text-[var(--surface-content-color)]">
      <%= accessible_t("invitations.sign_in_with_email", email: @invitation.email) %>
    </p>
  <% elsif @invitation.acceptable? %>
    <%= form_with url: accept_access_invitation_path(params[:token]), method: :post do %>
      <%= render FlatPack::Button::Component.new(
        text: accessible_t("invitations.accept"),
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
</div>
