<% content_for :title, access_request_t("sent_title") %>
<%= render layout: "recording_studio_accessible/access_requests/step" do %>
  <div class="flex flex-col gap-[var(--stack-gap-lg)] text-center" data-access-request-step="sent">
    <% if modal_frame_request? %>
      <%= render "recording_studio_accessible/access_requests/heading", title: access_request_t("sent_title") %>
    <% end %>
    <p><%= access_request_t("sent_body") %></p>
  </div>
<% end %>
