<% content_for :title, accessible_t("requests.form_title") %>
<% selected_role = params[:role].presence || RecordingStudioAccessible.roles_for(@recording).first %>
<% role_options = RecordingStudioAccessible.roles_for(@recording).map { |role| { value: role, label: accessible_role_name(role) } } %>
<%= render layout: "recording_studio_accessible/access_requests/step" do %>
  <div class="flex flex-col gap-[var(--stack-gap-lg)]" data-access-request-step="form">
    <div class="flex flex-col gap-[var(--stack-gap-sm)]">
      <h1 class="text-xl font-semibold"><%= accessible_t("requests.form_title") %></h1>
      <p><%= accessible_t("requests.form_intro") %></p>
    </div>
    <%= form_with url: recording_access_requests_path(@recording), method: :post,
                  class: "flex flex-col gap-[var(--stack-gap-lg)]", **access_request_form_options do %>
      <%= access_request_modal_fields %>
      <%= hidden_field_tag "access_request[action]", params[:access_action] %>
      <%= render FlatPack::RadioGroup::Component.new(
        name: "access_request[role]",
        label: accessible_t("requests.role"),
        options: role_options,
        value: selected_role,
        required: true
      ) %>
      <%= render FlatPack::TextArea::Component.new(
        name: "access_request[message]",
        label: accessible_t("requests.message"),
        rows: 4,
        max_characters: RecordingStudio::AccessRequest::MESSAGE_MAX
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: accessible_t("requests.submit"),
        style: :primary,
        size: :md,
        type: "submit",
        class: "w-full"
      ) %>
    <% end %>
  </div>
<% end %>
