<% request_record = @request_recording.recordable %>
<% content_for :title, access_request_show_heading(request_record) %>
<% content_for :subtitle, accessible_t("requests.requested_on", date: access_request_requested_on(@request_recording)) %>
<% unless modal_frame_request? %>
  <% flat_pack_page_nav(
       round: true,
       style: :default,
       anchor_href: recording_access_requests_path(@recording)
     ) %>
<% end %>
<%= render layout: "recording_studio_accessible/access_requests/step" do %>
  <div class="grid w-full max-w-xl gap-8" data-access-request-step="show">
    <% if modal_frame_request? || request_record.message.present? %>
      <div class="grid gap-3">
        <% if modal_frame_request? %>
          <%= render "recording_studio_accessible/access_requests/heading",
                     title: access_request_show_heading(request_record),
                     subtitle: accessible_t("requests.requested_on", date: access_request_requested_on(@request_recording)) %>
        <% end %>
        <% if request_record.message.present? %>
          <p>"<%= request_record.message %>"</p>
        <% end %>
      </div>
    <% end %>

    <% if manager? && access_request_gate_answers(request_record).any? %>
      <div class="grid gap-4">
        <% access_request_gate_answers(request_record).each do |label, value| %>
          <div>
            <p class="text-sm text-[var(--surface-muted-content-color)]"><%= label %></p>
            <p class="mt-1"><%= value %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if manager? %>
      <%= render FlatPack::Tabs::Component.new(
        variant: :underline,
        size: :sm,
        default_tab: access_request_decision_tab(request_record)
      ) do |tabs| %>
        <% tabs.tab(label: accessible_t("requests.approve"), id: "access-request-approve") do %>
          <%= form_with url: transition_recording_access_request_path(@recording, @request_recording),
                        method: :post,
                        class: "grid max-w-md gap-8 [&_fieldset]:m-0 [&_fieldset]:min-w-0 [&_fieldset]:border-0 [&_fieldset]:p-0",
                        **access_request_form_options do %>
            <%= access_request_modal_fields %>
            <%= hidden_field_tag :status, "approved" %>
            <%= render FlatPack::RadioGroup::Component.new(
              name: "role",
              variant: :inline,
              size: :sm,
              label: accessible_t("requests.approve_role"),
              options: access_request_approval_options(request_record),
              value: access_request_approval_default(request_record),
              required: true
            ) %>
            <div class="pt-6">
              <%= render FlatPack::Button::Component.new(
                text: accessible_t("requests.approve"), style: :primary, size: :md, type: "submit"
              ) %>
            </div>
          <% end %>
        <% end %>
        <% tabs.tab(label: accessible_t("requests.deny"), id: "access-request-deny") do %>
          <%= form_with url: transition_recording_access_request_path(@recording, @request_recording),
                        method: :post, class: "grid max-w-md gap-8", **access_request_form_options do %>
            <%= access_request_modal_fields %>
            <%= hidden_field_tag :status, "denied" %>
            <%= render FlatPack::TextArea::Component.new(
              name: "review_note",
              label: accessible_t("requests.deny_note"),
              value: request_record.review_note,
              rows: 3
            ) %>
            <div class="pt-6">
              <%= render FlatPack::Button::Component.new(
                text: accessible_t("requests.deny"), style: :primary, size: :md, type: "submit"
              ) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
