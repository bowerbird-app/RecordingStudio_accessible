<% recording = local_assigns.fetch(:recording) %>
<% role = local_assigns[:role] %>
<% action = local_assigns[:action] %>
<% copy = local_assigns[:copy] %>
<% scope = local_assigns[:scope] %>
<% label = local_assigns.fetch(:label) %>
<% modal_id = "access-request-#{recording.id}" %>

<%= render FlatPack::Button::Component.new(
  text: label,
  href: access_request_modal_src(recording, role: role, action: action, copy: copy, scope: scope),
  style: :primary,
  size: :md,
  data: { modal_id: modal_id, turbo_frame: access_request_frame_id }
) %>
<%= render FlatPack::Modal::Component.new(id: modal_id, size: :sm) do |modal| %>
  <% modal.body do %>
    <%= turbo_frame_tag access_request_frame_id %>
  <% end %>
<% end %>
<%= javascript_tag nonce: true do %>
  if (!document.documentElement.dataset.recordingStudioAccessibleAccessRequest) {
    document.documentElement.dataset.recordingStudioAccessibleAccessRequest = "true"
    document.addEventListener("turbo:before-cache", function () {
      document.querySelectorAll("[data-controller='flat-pack--modal'][id^='access-request-']").forEach(function (modal) {
        if (modal.classList.contains("hidden")) return

        modal.classList.add("hidden")
        modal.classList.remove("flex")
        modal.setAttribute("aria-hidden", "true")
        document.body.style.overflow = ""
      })
    })
  }
<% end %>
