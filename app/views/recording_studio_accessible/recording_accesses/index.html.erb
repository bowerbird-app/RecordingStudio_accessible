<% content_for :title, accessible_t("manage.title") %>
<% content_for :subtitle, @recording_label %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     anchor_href: recording_access_anchor_url
   ) %>
<% recording_studio_page_nav_right do %>
  <%= render FlatPack::ButtonGroup::Component.new(variant: :outlined) do |group| %>
    <% group.button(
         FlatPack::Button::Component.new(
           text: accessible_t("manage.add"),
           href: new_recording_access_path_with_back_url(@recording),
           style: :default,
           size: :sm
         )
       ) %>
    <% requests_button = FlatPack::Button::Component.new(
         text: accessible_t("requests.list_title"),
         href: recording_access_requests_path(@recording),
         style: :default,
         size: :sm
       ) %>
    <% if @pending_access_requests_count.to_i.positive? %>
      <% requests_button.with_trailing do %>
        <%= render FlatPack::Badge::Component.new(
              text: @pending_access_requests_count.to_s,
              size: :sm,
              style: :primary
            ) %>
      <% end %>
    <% end %>
    <% group.button(requests_button) %>
  <% end %>
<% end %>

<% show_actor_type_column = show_access_actor_type_column?(@direct_access_rows, @inherited_access_rows) %>

<% people_rows = people_with_access_rows(@direct_access_rows, @pending_invitation_rows) %>

<% if people_rows.any? %>
  <%= render FlatPack::Table::Component.new(data: people_rows) do |table| %>
      <% table.column(title: accessible_t("manage.columns.who")) do |row| %>
        <% if row[:kind] == :invitation %>
          <% pending_invitation_person_cell(row) %>
        <% else %>
          <% access_person_cell(row) %>
        <% end %>
      <% end %>
      <% if show_actor_type_column %>
        <% table.column(title: accessible_t("manage.columns.type")) do |row| %>
          <% access_actor_type_cell(row) %>
        <% end %>
      <% end %>
      <% table.column(title: accessible_t("manage.columns.role")) do |row| %>
        <% if row[:kind] == :invitation %>
          <% pending_invitation_role_cell(row) %>
        <% else %>
          <% access_role_cell(row) %>
        <% end %>
      <% end %>
      <% table.column(title: accessible_t("manage.columns.actions")) do |row| %>
        <% if row[:kind] == :invitation %>
          <% pending_invitation_actions_cell(@recording, row) %>
        <% else %>
          <% access_actions_cell(@recording, row) %>
        <% end %>
      <% end %>
  <% end %>
<% else %>
  <%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
    <% card.body(class: "grid gap-3 justify-items-start") do %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: accessible_t("manage.empty_title"),
        subtitle: accessible_t("manage.empty_subtitle"),
        anchor_link: true,
        anchor_id: "no-direct-grants"
      ) %>
    <% end %>
  <% end %>
<% end %>

<% if @inherited_access_rows.any? %>
  <div class="mt-8 grid gap-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: accessible_t("manage.inherited_title"),
      subtitle: accessible_t("manage.inherited_subtitle"),
      anchor_link: true,
      anchor_id: "other-people-with-access"
    ) %>

    <%= render FlatPack::Table::Component.new(data: @inherited_access_rows) do |table| %>
      <% table.column(title: accessible_t("manage.columns.who")) { |row| access_person_cell(row) } %>
      <% if show_actor_type_column %>
        <% table.column(title: accessible_t("manage.columns.type")) { |row| access_actor_type_cell(row) } %>
      <% end %>
      <% table.column(title: accessible_t("manage.columns.access_point")) { |row| inherited_access_source_cell(row) } %>
      <% table.column(title: accessible_t("manage.columns.role")) { |row| inherited_access_source_role_cell(row) } %>
      <% table.column(title: accessible_t("manage.columns.actions")) { |row| inherited_access_actions_cell(@recording, row) } %>
    <% end %>
  </div>
<% end %>
