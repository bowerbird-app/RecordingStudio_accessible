<div class="mx-auto w-full max-w-6xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: accessible_t("home.overview.title"),
    subtitle: accessible_t("home.overview.subtitle"),
    variant: :h1
  ) %>

  <section class="mt-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: accessible_t("home.overview.add_access_title"),
      subtitle: accessible_t("home.overview.add_access_subtitle"),
      anchor_link: true,
      anchor_id: "add-access-to-something"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      code: "- Page\n-- Access",
      separated: false
    ) %>
  </section>
</div>
