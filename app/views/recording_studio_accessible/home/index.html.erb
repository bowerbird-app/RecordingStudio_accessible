<% content_for :title, accessible_t("home.index.title") %>
<% content_for :subtitle, accessible_t("home.index.subtitle") %>
<div class="mx-auto w-full max-w-6xl">

  <div class="mt-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: accessible_t("home.index.snapshot_title"),
      subtitle: accessible_t("home.index.snapshot_subtitle"),
      anchor_link: true,
      anchor_id: "access-check-snapshot"
    ) %>

    <%= render FlatPack::List::Component.new(layout: :key_value, divider: true) do %>
      <%= render FlatPack::List::Item.new(key: accessible_t("home.index.integration_mode")) do %>
        <%= @integration_mode %>
      <% end %>
      <%= render FlatPack::List::Item.new(key: accessible_t("home.index.workspace")) do %>
        <%= @workspace&.name || accessible_t("home.index.not_available") %>
      <% end %>
      <%= render FlatPack::List::Item.new(key: accessible_t("home.index.root_recording")) do %>
        <%= @root_recording&.id || accessible_t("home.index.not_available") %>
      <% end %>
    <% end %>
  </div>
</div>
