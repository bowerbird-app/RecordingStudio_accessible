<div class="mx-auto w-full max-w-6xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: accessible_t("home.index.title"),
    subtitle: accessible_t("home.index.subtitle"),
    variant: :h1
  ) %>

  <div class="mt-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: accessible_t("home.index.snapshot_title"),
      subtitle: accessible_t("home.index.snapshot_subtitle"),
      anchor_link: true,
      anchor_id: "access-check-snapshot"
    ) %>

    <div class="grid gap-3">
      <p><strong><%= accessible_t("home.index.integration_mode") %></strong> <%= @integration_mode %></p>
      <p><strong><%= accessible_t("home.index.workspace") %></strong> <%= @workspace&.name || accessible_t("home.index.not_available") %></p>
      <p><strong><%= accessible_t("home.index.root_recording") %></strong> <%= @root_recording&.id || accessible_t("home.index.not_available") %></p>
    </div>
  </div>
</div>
