source "https://rubygems.org"

require_relative "../support/widen_recording_studio_requirement"

# Use the recording_studio_accessible engine
gem "recording_studio_accessible", path: "../.."

# RecordingStudio engine
gem "recording_studio", github: "bowerbird-app/RecordingStudio", tag: "v6.1.0"
# Query-only trash helpers (Accessible gemspec "~> 0.10"; pin by tag).
# require: false — Accessible loads recording_studio_trashable/query only.
gem "recording_studio_trashable", github: "bowerbird-app/RecordingStudio_trashable",
                                  tag: "v0.11.2", require: false
gem "recording_studio_root_switchable", github: "bowerbird-app/RecordingStudio_root_switchable", tag: "v0.9.6"
# Required by root_switchable and trashable (git-only; not on RubyGems).
gem "recording_studio_metrics", github: "bowerbird-app/RecordingStudio_metrics", tag: "v0.5.0"

# Dummy-only language switching. Accessible ships English; hosts own other languages.
gem "recording_studio_internationalization",
    github: "bowerbird-app/RecordingStudio_Internationalization", tag: "v0.1.7"

# Devise authentication
gem "devise"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.1"
# The modern asset pipeline for Rails [https://github.com/rails/propshaft]
gem "propshaft"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", "~> 7.2.1"
# Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails"
# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails"
# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
gem "jbuilder"

# Use Tailwind CSS [https://github.com/rails/tailwindcss-rails]
gem "tailwindcss-rails"

# FlatPack UI component library [https://github.com/bowerbird-app/flatpack]
# VERSION 0.1.319 on main. The v0.1.319 tag is not published yet.
gem "flat_pack", github: "bowerbird-app/flatpack", ref: "1fcbafe94f8eb118f0a22182f63f5110fcc97a56"
gem "minitest", ">= 5.26", "< 6"
gem "view_component", "4.19.0"

# Email-code accounts for access requests. Accessible soft-requires Users
# because Users already depends on Accessible.
gem "recording_studio_admin", github: "bowerbird-app/RecordingStudio_admin", tag: "v2.5.1"
