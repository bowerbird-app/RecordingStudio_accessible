<div class="mx-auto w-full max-w-5xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: @workspace.name,
    subtitle: "Shared workspace preview",
    variant: :h1
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md, class: "mt-6") do %>
    <%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Folders",
          subtitle: "Content currently inside this workspace",
          anchor_link: true,
          anchor_id: "workspace-folders"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new do %>
          <% @workspace.folders.map(&:name).each do |name| %>
            <%= render FlatPack::List::Item.new do %>
              <%= name %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Pages",
          subtitle: "Nested pages reachable from this workspace",
          anchor_link: true,
          anchor_id: "workspace-pages"
        ) %>
      <% end %>

      <% card.body do %>
        <% page_titles = @workspace.folders.flat_map { |folder| folder.pages.map(&:title) } %>
        <%= render FlatPack::List::Component.new do %>
          <% page_titles.each do |title| %>
            <%= render FlatPack::List::Item.new do %>
              <%= title %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
