<div class="mx-auto w-full max-w-5xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Message groups",
    subtitle: "Demo of access through #{@through_workspace&.name || "a workspace"}",
    variant: :h1
  ) %>

  <div class="mt-6">
    <% if @message_groups.any? %>
      <%= render FlatPack::Table::Component.new(data: @message_groups) do |table| %>
        <% table.column(title: "Message group") { |row| row[:name] } %>
        <% table.column(title: "Root") { |row| row[:root] } %>
        <% table.column(title: "Direct access") { |row| row[:direct_access] ? "Yes" : "No" } %>
        <% table.column(title: "Through access") { |row| row[:through_access] ? "Yes" : "No" } %>
        <% table.column(title: "Effective role") { |row| row[:role].to_s.humanize } %>
      <% end %>
    <% else %>
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.body(class: "grid gap-3 justify-items-start") do %>
          <%= render FlatPack::SectionTitle::Component.new(
            title: "No message groups",
            subtitle: "This actor cannot view message groups through the demo workspace.",
            anchor_link: true,
            anchor_id: "no-message-groups"
          ) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>