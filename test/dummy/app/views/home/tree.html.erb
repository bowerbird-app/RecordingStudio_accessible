<div class="mx-auto w-full max-w-6xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Tree",
    subtitle: "Recording hierarchy for all recordings in the dummy app (#{@recording_count})",
    variant: :h1
  ) %>

  <div class="mt-6">
    <% if @recording_tree_nodes.any? %>
      <%= render FlatPack::Tree::Component.new do |tree| %>
        <% append_recording_tree_nodes(tree, @recording_tree_nodes) %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No recordings were found.",
        description: "Seed the dummy app, then refresh this tree."
      ) %>
    <% end %>
  </div>
</div>
