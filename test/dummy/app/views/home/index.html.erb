<div class="mx-auto w-full max-w-6xl">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Accessible Demo",
    subtitle: "Demo of how access works",
    variant: :h1
  ) %>

  <div class="mt-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Workspaces",
      subtitle: "Root recordables",
      anchor_link: true,
      anchor_id: "workspace-access"
    ) %>

    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md, align: :start, class: "mb-6 w-full") do %>
      <% if @workspace %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.body(class: "grid gap-3 justify-items-start") do %>
            <h3 class="text-lg font-semibold leading-tight text-slate-900"><%= @workspace.name %></h3>
            <%= render FlatPack::Badge::Component.new(text: @workspace.class.name, style: :default, size: :sm) %>
            <% if @root_recording && @root_access_management_enabled %>
              <%= recording_studio_accessible_avatars(@root_recording, button_style: :default, scope: :all) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::SectionTitle::Component.new(
      title: "Folders and pages",
      anchor_link: true,
      anchor_id: "folders-and-pages"
    ) %>

    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md, align: :start, class: "w-full") do %>
      <% @demo_sections.each do |section| %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.body(class: "grid gap-3 justify-items-start") do %>
            <h3 class="text-lg font-semibold leading-tight text-slate-900"><%= section[:folder].name %></h3>
            <%= render FlatPack::Badge::Component.new(text: section[:folder].class.name, style: :default, size: :sm) %>
            <% if section[:folder_recording] && section[:folder_access_management_enabled] %>
              <%= recording_studio_accessible_avatars(section[:folder_recording], button_style: :default, scope: :all) %>
            <% end %>
          <% end %>
        <% end %>

        <% section[:pages].each do |page_section| %>
          <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
            <% card.body(class: "grid gap-3 justify-items-start") do %>
              <h3 class="text-lg font-semibold leading-tight text-slate-900"><%= page_section[:page].title %></h3>
              <%= render FlatPack::Badge::Component.new(text: page_section[:page].class.name, style: :default, size: :sm) %>
              <p class="text-sm text-slate-600">Pages not allowed to add access</p>
              <% if page_section[:page_recording] && page_section[:page_access_management_enabled] %>
                <%= recording_studio_accessible_avatars(page_section[:page_recording], button_style: :default) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="mt-6">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Access through",
        subtitle: "Demo of one actor using another actor's access grant. The button below lists message groups the current user can see by acting through the Accessible Demo Workspace.",
        anchor_link: true,
        anchor_id: "access-through"
      ) %>

      <div class="mt-4">
        <%= render FlatPack::Button::Component.new(
          text: "Message groups",
          style: :default,
          size: :md,
          url: message_groups_path
        ) %>
      </div>
    </div>

    <div class="mt-6">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Access Actions",
        subtitle: "Demo of the action authorization registry. Registered actions are evaluated against the current actor and workspace root recording. Actions fail closed when the policy returns false.",
        anchor_link: true,
        anchor_id: "access-actions"
      ) %>

      <div class="mt-4">
        <% if @action_rows.any? %>
          <%= render FlatPack::Table::Component.new(data: @action_rows) do |table| %>
            <% table.column(title: "Action") { |row| row[:label] } %>
            <% table.column(title: "Description") { |row| row[:description] } %>
            <% table.column(title: "Access") { |row| row[:allowed] ? "Approved" : "Denied" } %>
            <% table.column(title: "Actions") { |row| link_to("View", access_action_path(row[:action]), class: "text-primary-600 underline text-sm") } %>
          <% end %>
        <% else %>
          <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
            <% card.body(class: "grid gap-3 justify-items-start") do %>
              <%= render FlatPack::SectionTitle::Component.new(
                title: "No actions",
                subtitle: "No actions are registered or the workspace is unavailable.",
                anchor_link: true,
                anchor_id: "no-actions"
              ) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>