<% if @greeting_email.present? %>
  <p><%= accessible_t("mailers.hello", email: @greeting_email) %></p>
<% else %>
  <p><%= accessible_t("mailers.hello_there") %></p>
<% end %>

<% if @recording_label.present? %>
  <p><%= accessible_t("mailers.granted.body_html", granter: @manager_actor_display_name, role: @role_label, recording: @recording_label) %></p>
<% else %>
  <p><%= accessible_t("mailers.granted.body_html_without_recording", granter: @manager_actor_display_name, role: @role_label) %></p>
<% end %>

<% if @access_url.present? %>
  <p><a href="<%= @access_url %>"><%= accessible_t("mailers.granted.open") %></a></p>
<% end %>
